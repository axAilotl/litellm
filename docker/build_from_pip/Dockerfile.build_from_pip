# Fixed upstream Node is shared by builds and Prisma; no Python-bundled runtime.
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS node_security

FROM python:3.13-alpine
COPY --from=node_security /usr/local/bin/node /usr/local/bin/node
RUN apk add --no-cache libstdc++
ENV PATH="/usr/local/bin:${PATH}" PRISMA_USE_NODEJS_BIN=false PRISMA_USE_GLOBAL_NODE=true

WORKDIR /app

ENV HOME=/home/litellm
ENV PATH="${HOME}/venv/bin:$PATH"

# Install runtime dependencies
# Note: Using Python 3.13 for compatibility with ddtrace and other packages
# rust and cargo are required for building ddtrace from source
# musl-dev and libffi-dev are needed for some Python packages on Alpine
RUN apk update && \
    apk add --no-cache gcc musl-dev libffi-dev openssl openssl-dev rust cargo

RUN python -m venv ${HOME}/venv
RUN ${HOME}/venv/bin/pip install --no-cache-dir --upgrade pip

COPY docker/build_from_pip/requirements.txt .
RUN --mount=type=cache,target=${HOME}/.cache/pip \
    ${HOME}/venv/bin/pip install -r requirements.txt

# Python distributions must use the fixed image-owned Node interpreter.
RUN ${HOME}/venv/bin/pip uninstall -y nodejs-wheel-binaries nodejs-bin

# Copy Prisma schema file
COPY schema.prisma .

# Generate prisma client
RUN prisma generate

EXPOSE 4000/tcp

ENTRYPOINT ["litellm"]
CMD ["--port", "4000"]

USER root
RUN ln -sf /usr/local/bin/node /usr/bin/node \
    && node -e 'if (process.version !== "v24.22.1") throw new Error("Unexpected Node runtime")'
